{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "独山麻将",
  "version": "1.1.0",
  "identifier": "com.zhuoji.mahjong",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "独山麻将 · 大师之路",
        "width": 960,
        "height": 540,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "独山麻将 · 大师之路",
    "longDescription": "独山麻将 AI 对局与大师推荐。APP 为全屏客户端，连接同一局域网内已启动的 Python 对局服务端；游戏界面、规则与 AI 推理均由服务端原样提供，客户端不做任何改写。",
    "android": {
      "minSdkVersion": 24
    }
  }
}
