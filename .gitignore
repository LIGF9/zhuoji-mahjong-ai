# 项目工作区数据（重要：不是缓存，绝不删除；也不进 git）
.workbuddy/

# 离线端编译期用 include_bytes! 嵌入的 3 个 ONNX 必须入库（CI 三端构建要用）；
# 其余训练 / 实验导出的 ONNX 只在本地保留，不进仓库。
models/onnx/*
!models/onnx/champ_slim_s.onnx
!models/onnx/dushan_master.onnx
!models/onnx/expert_s7.onnx

# Rust 构建产物
rust_engine/target/
offline/target/
tauri-offline/src-tauri/target/
tauri-offline/node_modules/
# 桌面版（desktop/）：Tauri 构建产物与自动生成的 gen 目录
desktop/src-tauri/target/
desktop/src-tauri/gen/
# 桌面版交付物（.app / 压缩包，按需本地重建）
desktop/dist/
tauri-offline/src-tauri/gen/android/.kotlin/
tauri-offline/src-tauri/gen/android/.gradle/
tauri-offline/src-tauri/gen/android/.tauri/
# 离线版出包目录（体积大，按需本地重建；构建脚本 runs/build_offline_apk.sh）
tauri-offline/dist/

# 实验运行日志（ctrl_*.jsonl 等）
runs/

# 破损的 ONNX 外部数据残留
*.onnx.data

# 冒烟测试产物
models/*_smoke.pt

# ExIt 训练产物（本地保留，不进 git——每轮 30MB+ 快照）
models/exit_r*.pt
models/exit_best.pt
models/web_best.pt
# PPO-lite 每轮检查点（同量级，本地保留）
models/exit_p*.pt

# Oracle 构建独立目录（在跑二进制 target/release 不动）
rust_engine/target_oracle/

# 编辑备份
web/*.bak-*

# 本地编译产物 / 运行时日志 / 签名密钥（都不进仓库）
dushan_engine.so
reports/exit_log.md
*.keystore
ci-debug.keystore
*.zip
*.dmg

# 已从远端移除、本地仍保留的旧工程 / 生成资源 / 实验归档（2026-11-14 精简）
