tauri-app/
tauri-offline/src-tauri/icons/ios/
docs/*.txt.gz
reports/*.tar.gz

# 蒸馏学生中间检查点（TA / S1，本地保留）
models/slim_*.pt

# 桌面版图标生成的中间产物（由 desktop/app-icon.png 重新生成）
desktop/build/
desktop/dist/

# 出包产物（tools/pack_all.sh 生成，文件名带打包时间 → 每次都不一样，不进 git）
tauri-offline/dist/
