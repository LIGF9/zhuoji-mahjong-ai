{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "独山麻将",
  "version": "1.2.0",
  "identifier": "com.zhuoji.mahjong.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "独山麻将",
        "url": "http://127.0.0.1:8771/",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "独山麻将",
    "longDescription": "独山麻将桌面版：规则、结算与 AI 推理全部由内置 Rust 服务端完成，双击即玩；同一 Wi-Fi 下手机浏览器可直接连本机对战。"
  }
}
