{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "独山麻将·单机",
  "version": "1.0.0",
  "identifier": "com.zhuoji.mahjong",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "独山麻将 · 单机离线",
        "width": 960,
        "height": 540,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "独山麻将 · 单机离线",
    "longDescription": "完全离线的独山麻将 AI 对局：规则、结算与 AI 推理全部在设备内用 Rust 完成，断网可玩，无需服务端。",
    "android": {
      "minSdkVersion": 24
    }
  }
}
