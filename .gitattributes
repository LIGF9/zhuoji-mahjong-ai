# 统一行尾为 LF，保证 Windows ↔ macOS 之间 clone 不产生整库差异
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# 二进制：禁止任何转换
*.pt    binary
*.pth   binary
*.npz   binary
*.npy   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.ico   binary

# 让 GitHub 语言统计正确
*.html  linguist-documentation=false
